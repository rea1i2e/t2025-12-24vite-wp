{
  "permissions": {
    "additionalDirectories": [
      "../../../../../../../working/2026-04-23kn"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/.htpasswd)",
      "Read(//**/*.pem)",
      "Read(//**/id_rsa)",
      "Read(//**/id_rsa.pub)",
      "Read(//**/*credentials*.json)",
      "Read(//**/*.env)",
      "Read(//**/.config/shin-account/**)",
      "Read(//**/.config/notion/**)",
      "Read(//**/.ssh/**)",
      "Read(//**/.gnupg/**)",
      "Read(//**/.aws/**)",
      "Read(//**/.npmrc)",
      "Read(//**/.git-credentials)",
      "Read(//**/.codex/config.toml)",
      "Read(//**/*.mcp.json)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(chmod -R 777:*)"
    ]
  },
  "hooks": {
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/stopfailure-handoff.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/secret-path-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
