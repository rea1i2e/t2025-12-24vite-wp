{
  "name": "t2025-12-24vite-wp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild-image-set.mjs",
    "preview": "open http://t2025-12-24vite-wp.local",
    "local:admin": "open http://t2025-12-24vite-wp.local/wp-admin/",
    "build:preview": "npm run build && npm run preview",
    "clean": "rm -rf dist src/.vite src/.img",
    "clean:all": "rm -rf dist src/.vite src/.img node_modules package-lock.json",
    "reinstall": "npm run clean:all && npm install",
    "init": "bash scripts/init-project.sh",
    "prepare": "husky",
    "capture:qa": "node scripts/capture-qa-screenshot.mjs",
    "capture:qa:all": "CAPTURE_QA_CONFIG=ai-docs/capture-qa.config.json node scripts/capture-qa-all.mjs",
    "check:unused": "node scripts/check-unused.mjs",
    "check:images": "node scripts/check-images.mjs",
    "check:prod-deploy-drift": "node scripts/check-prod-deploy-drift.mjs",
    "test:prod-deploy-drift": "node --test scripts/check-prod-deploy-drift.test.mjs",
    "check:exclude-parity": "node scripts/check-exclude-parity.mjs"
  },
  "devDependencies": {
    "@vheemstra/vite-plugin-imagemin": "^2.2.1",
    "autoprefixer": "^10.4.21",
    "husky": "^9.1.7",
    "image-size": "^1.1.1",
    "imagemin-avif": "^0.1.6",
    "imagemin-gif2webp": "^3.0.0",
    "imagemin-gifsicle": "^7.0.0",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-optipng": "^8.0.0",
    "imagemin-svgo": "^12.0.0",
    "imagemin-webp": "^8.0.0",
    "playwright": "^1.51.0",
    "postcss": "^8.5.33",
    "postcss-sort-media-queries": "^5.2.0",
    "sass": "^1.93.0",
    "vite": "^6.4.6",
    "vite-plugin-sass-glob-import": "^5.0.0"
  },
  "dependencies": {
    "@splidejs/splide": "^4.1.4",
    "@splidejs/splide-extension-auto-scroll": "^0.5.3",
    "basic-ftp": "^6.2.6",
    "flatpickr": "^4.6.13",
    "kiso.css": "^1.2.2",
    "micromatch": "^4.0.8"
  }
}
